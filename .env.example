# MAP-USA environment variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to version control.

# --- Email (used by /api/contact and bug-report admin notifications) ---
# For Gmail, SENDER_PASSWORD must be an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=

# --- Admin login (used by /pages/admin.html) ---
# Password required to view and manage submitted bug reports.
# If unset, defaults to "changeme" (do NOT use the default in any deployed demo).
ADMIN_PASSWORD=

# --- Flask session signing key ---
# Any long random string. Used to sign the admin session cookie.
# If unset, a random key is generated on each server start, which logs out
# all admins whenever the server restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
